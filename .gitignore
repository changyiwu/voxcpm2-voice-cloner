# .gitignore

# Python 虛擬環境
.venv/
venv/

# 模型權重（太大，不進 repo）
checkpoints/
pretrained_models/
*.safetensors
*.pth

# 音檔（含 voices/ 內的參考音，屬個人資料不進版控）
ref_voice.wav
*.wav
output/

# 聲音資料夾（每個人的參考音與逐字稿，本地保留但不進版控）
voices/

# GPU 類型標記
.gpu_type

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# 備份檔（加 UTF-8 BOM 前的原檔，git 已有歷史紀錄）
*.bak

# 系統
desktop.ini
*.tmp
~$*
.DS_Store
Thumbs.db

# 敏感資料
.env
*.key
credentials.*

# 交接檔含真實電腦名與本機路徑，只走雲端硬碟同步，不進公開 repo
handoff.md

# 全域技能原始檔（含本機絕對路徑與個人聲音名稱），只走雲端硬碟同步，不進公開 repo
skills/
